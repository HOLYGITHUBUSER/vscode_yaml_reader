{
  "name": "yaml-reader",
  "displayName": "YAML Reader",
  "description": "Fast YAML Reader and opt-in editing Workbench for VS Code and Cursor.",
  "version": "0.5.0",
  "publisher": "yaml-reader",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/HOLYGITHUBUSER/vscode_yaml_reader.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "yaml",
    "viewer",
    "reader",
    "tree",
    "cursor",
    "remote ssh"
  ],
  "main": "./07-artifacts-安装包/extension-扩展入口.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml",
    "onCommand:yamlReader.openPreview",
    "onCommand:yamlReader.openWorkbench",
    "onCustomEditor:yamlReader.preview",
    "onCustomEditor:yamlReader.workbench"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "yamlReader.openPreview",
        "title": "YAML Reader: Open Read-only View",
        "shortTitle": "Open YAML Reader",
        "category": "YAML Reader",
        "icon": "$(preview)"
      },
      {
        "command": "yamlReader.openWorkbench",
        "title": "YAML Reader: Open Editing Workbench",
        "shortTitle": "Open YAML Workbench",
        "category": "YAML Reader",
        "icon": "$(edit)"
      }
    ],
    "customEditors": [
      {
        "viewType": "yamlReader.workbench",
        "displayName": "YAML Reader",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "yamlReader.preview",
        "displayName": "YAML Reader (只读)",
        "selector": [
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yamlReader.openPreview",
          "when": "editorLangId == yaml",
          "group": "navigation@20"
        },
        {
          "command": "yamlReader.openWorkbench",
          "when": "editorLangId == yaml",
          "group": "navigation@21"
        }
      ],
      "editor/context": [
        {
          "command": "yamlReader.openPreview",
          "when": "editorLangId == yaml",
          "group": "navigation@20"
        },
        {
          "command": "yamlReader.openWorkbench",
          "when": "editorLangId == yaml",
          "group": "navigation@21"
        }
      ],
      "explorer/context": [
        {
          "command": "yamlReader.openPreview",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation@20"
        },
        {
          "command": "yamlReader.openWorkbench",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation@21"
        }
      ]
    },
    "configuration": {
      "title": "YAML Reader",
      "properties": {
        "yamlReader.defaultExpandDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 6,
          "description": "Initial expansion depth. 0 shows document roots only; 1 shows top-level YAML entries."
        },
        "yamlReader.rowHeight": {
          "type": "number",
          "default": 32,
          "minimum": 26,
          "maximum": 44,
          "description": "Tree row height in pixels."
        },
        "yamlReader.rememberExpansion": {
          "type": "boolean",
          "default": true,
          "description": "Remember expansion and selection state while the reader tab remains open."
        },
        "yamlReader.searchDebounceMs": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "description": "Delay before applying a search query."
        }
      }
    }
  },
  "scripts": {
    "clean": "node 08-scripts-构建脚本/build-构建.mjs clean",
    "build": "node 08-scripts-构建脚本/build-构建.mjs build",
    "watch": "node 08-scripts-构建脚本/build-构建.mjs watch",
    "typecheck": "tsc -p 00-config-工程配置/tsconfig-编译配置.json --noEmit",
    "test:unit": "vitest run --config 00-config-工程配置/vitest-测试配置.ts",
    "test:coverage": "vitest run --config 00-config-工程配置/vitest-测试配置.ts --coverage",
    "test:integration": "npm run build && node 08-scripts-构建脚本/build-构建.mjs integration",
    "test:performance": "npm run test:unit -- --runInBand",
    "test": "npm run test:unit && npm run test:integration",
    "package": "npm run build && vsce package --out 07-artifacts-安装包/yaml-reader-YAML阅读器-${npm_package_version}.vsix",
    "verify": "npm run typecheck && npm run test:coverage && npm run test:integration && npm run package"
  },
  "dependencies": {
    "preact": "^10.29.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.10.0",
    "@types/vscode": "1.100.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "icon": "07-artifacts-安装包/icon-扩展图标.png"
}
