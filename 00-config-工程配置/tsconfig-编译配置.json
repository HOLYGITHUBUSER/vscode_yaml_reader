{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "../out",
    "rootDir": "../01-extension-扩展逻辑",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "strict": true,
